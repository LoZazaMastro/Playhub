<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PlayhubSetup</RootNamespace>
    <AssemblyName>Playhub Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\Playhub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.6.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Andrea Sgarro (LoZazaMastro)</Company>
    <Product>Playhub Setup</Product>
    <!-- Single-file self-contained: vedi build-installer.bat -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
    <AssemblyMetadata Include="PlayhubControllerDriverRequired" Value="true" Condition="'$(PlayhubControllerDriverRequired)' == 'true'" />
    <Compile Include="../Shared/EditorialPhotoMigration.cs" Link="EditorialPhotoMigration.cs" />
    <Compile Include="../Shared/GamingModeInstallationPolicy.cs" Link="GamingModeInstallationPolicy.cs" />
    <Compile Include="../Shared/ShellIdentity.cs" Link="ShellIdentity.cs" />
    <Compile Include="../Playhub/Services/DeckyPluginService.cs" Link="BundledPlugins/DeckyPluginService.cs" />
    <Compile Include="../Playhub/Services/BundledExecutableCopy.cs" Link="BundledPlugins/BundledExecutableCopy.cs" />
    <Compile Include="../Playhub/Services/AppPaths.cs" Link="BundledPlugins/AppPaths.cs" />
    <Compile Include="../Playhub/Models/DeckyPluginInfo.cs" Link="BundledPlugins/DeckyPluginInfo.cs" />
    <Compile Include="../ApplicationIntegrations/Native/SteamPluginBridge.cs" Link="BundledPlugins/SteamPluginBridge.cs" />
    <Resource Include="Assets\cube.png" />
    <Resource Include="Assets\wordmark.png" />
  </ItemGroup>

  <!-- NB: il payload NON è incorporato come risorsa (200 MB di EmbeddedResource
       fanno fallire la build per memoria). Viene invece APPESO in coda all'exe
       da build-installer.bat dopo la compilazione: vedi Installer.cs. -->

</Project>
