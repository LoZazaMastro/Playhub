<Window x:Class="PlayhubSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playhub Setup"
        Width="780" Height="500"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

  <Border x:Name="Root" CornerRadius="8" Background="#9E121316">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== Barra titolo (trascinabile) + chiudi ===== -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
        <TextBlock Text="Playhub Setup" Foreground="#8AFFFFFF" FontSize="12"
                   VerticalAlignment="Center" Margin="18,0,0,0"/>
        <Button x:Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                FontSize="11" Foreground="#C8FFFFFF" Width="46" Height="46"
                HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                BorderThickness="0" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="cb" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="cb" Property="Background" Value="#E81123"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <!-- ===== Corpo: logo a sinistra, contenuto a destra ===== -->
      <Grid Grid.Row="1" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="266"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonna logo -->
        <Border Grid.Column="0" Background="#26000000">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
            <Image Source="Assets/wordmark.png" Width="200"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Width="64" Height="4" CornerRadius="2" Background="#FFCB0F" Margin="0,24,0,0"/>
            <TextBlock x:Name="VersionText" Text="versione 2.0.0" Foreground="#8AFFFFFF"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>

        <!-- Colonna contenuto: tre stati sovrapposti -->
        <Grid Grid.Column="1" Margin="34,8,34,28">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Contenuto degli stati (sovrapposti) -->
          <Grid Grid.Row="0">

          <!-- STATO: LINGUA -->
          <StackPanel x:Name="PanelLanguage" VerticalAlignment="Center">
            <TextBlock x:Name="LangTitle" Text="Choose your language" Foreground="#F2F2F2"
                       FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="LangSubtitle"
                       Text="Select the language for Playhub and the installer."
                       Foreground="#A8A8A8" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <ListBox x:Name="LangList" Height="196" Margin="0,16,0,0"
                     Style="{StaticResource LangListStyle}"/>
          </StackPanel>

          <!-- STATO: TERMINI DI UTILIZZO -->
          <StackPanel x:Name="PanelAgreement" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="AgreeTitle" Text="Terms of Use" Foreground="#F2F2F2"
                       FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="AgreeSubtitle" Text="Read and accept to continue the installation."
                       Foreground="#A8A8A8" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border Background="#1B1D1F" CornerRadius="8" BorderBrush="#2A2D30" BorderThickness="1"
                    Margin="0,16,0,0">
              <ScrollViewer Height="206" VerticalScrollBarVisibility="Auto" Padding="14,12">
                <TextBlock x:Name="AgreeBody" Foreground="#D0D0D0" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="19"/>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PanelMerge" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="MergeTitle" Foreground="#F2F2F2" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Grid Margin="0,22,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Background="#24262A" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" Stroke="#FFCB0F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" Stroke="#FFCB0F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" Stroke="#FFCB0F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M14 17h6m-3 -3v6" Stroke="#FFCB0F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Shortcuts" Foreground="#F2F2F2" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Background="#24262A" CornerRadius="12" Padding="12">
                  <StackPanel Orientation="Horizontal"><Viewbox Width="24" Height="24"><Canvas Width="512" Height="512"><Path Data="M496 384H160v-16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v16H16c-8.8 0-16 7.2-16 16v32c0 8.8 7.2 16 16 16h80v16c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16v-16h336c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zm0-160h-80v-16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v16H16c-8.8 0-16 7.2-16 16v32c0 8.8 7.2 16 16 16h336v16c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16v-16h80c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zm0-160H288V48c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v16H16C7.2 64 0 71.2 0 80v32c0 8.8 7.2 16 16 16h208v16c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16v-16h208c8.8 0 16-7.2 16-16V80c0-8.8-7.2-16-16-16z" Fill="#FFCB0F"/></Canvas></Viewbox><TextBlock Text="Quick Settings" Foreground="#F2F2F2" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#FFCB0F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border Grid.Column="2" Background="#24262A" CornerRadius="12" Padding="12">
                <StackPanel VerticalAlignment="Center"><Viewbox Width="52" Height="52"><Canvas Width="398" Height="398"><Path Data="F0 M228 26L248 26L248 27L257 27L257 28L262 28L262 29L266 29L266 30L271 30L271 31L275 31L275 32L281 33L281 34L283 34L283 35L289 36L289 37L291 37L291 38L293 38L293 39L295 39L295 40L298 40L299 42L301 42L301 43L305 44L305 45L306 45L306 46L308 46L309 48L313 49L314 51L316 51L316 52L317 52L318 54L320 54L320 55L321 55L321 56L323 57L323 58L325 58L325 59L326 59L326 60L327 60L327 61L328 61L328 62L330 63L330 64L331 64L331 65L333 65L333 67L334 67L334 68L336 68L336 70L337 70L337 71L338 71L338 72L339 72L339 73L340 73L340 74L341 74L342 76L343 76L343 77L344 77L344 79L345 79L345 80L347 81L347 83L348 83L348 84L349 84L350 86L351 86L352 90L353 90L353 91L354 91L354 93L356 94L356 96L357 96L357 98L359 99L360 103L362 104L362 107L363 107L363 109L364 109L364 111L365 111L366 115L367 115L367 119L368 119L368 121L369 121L369 124L370 124L370 126L371 126L371 130L372 130L372 133L373 133L373 137L374 137L374 143L375 143L376 154L377 154L377 190L376 190L376 195L375 195L374 206L373 206L373 210L372 210L372 214L371 214L370 220L369 220L369 223L368 223L368 225L367 225L367 229L366 229L366 231L365 231L365 233L364 233L364 235L363 235L363 237L362 237L362 239L361 239L360 243L359 243L359 245L358 245L358 247L356 248L355 252L354 252L354 253L353 253L353 255L351 256L351 258L350 258L349 260L348 260L348 262L347 262L347 263L346 263L345 265L344 265L344 267L343 267L343 268L342 268L342 269L340 270L340 271L339 271L339 273L337 273L337 274L336 274L336 276L335 276L335 277L333 277L333 279L332 279L332 280L330 280L330 281L329 281L329 282L328 282L328 283L327 283L327 284L325 285L325 286L324 286L324 287L322 287L322 288L321 288L320 290L318 290L318 291L316 292L316 293L314 293L313 295L309 296L308 298L306 298L306 299L302 300L301 302L298 302L298 303L296 303L296 304L294 304L294 305L290 306L290 307L284 308L284 309L282 309L282 310L278 310L278 311L275 311L275 312L272 312L272 313L262 314L262 315L256 315L256 316L221 316L221 315L215 315L215 314L210 314L210 313L202 312L202 311L200 311L200 310L197 310L197 309L191 308L191 307L189 307L189 306L187 306L187 305L185 305L185 304L181 303L181 302L179 302L179 301L178 301L178 300L176 300L175 298L171 297L170 295L168 295L168 294L167 294L167 293L166 293L166 292L164 291L164 290L163 290L163 289L160 289L160 349L160 421L161 421L161 422L160 422L160 424L84 424L84 423L83 423L83 31L160 31L160 32L161 32L161 33L160 33L160 53L163 53L163 51L165 51L165 50L166 50L167 48L169 48L169 47L171 46L171 45L175 44L176 42L178 42L178 41L182 40L182 39L183 39L183 38L185 38L185 37L188 37L188 36L190 36L190 35L193 35L193 34L195 34L195 33L198 33L198 32L201 32L201 31L205 31L205 30L209 30L209 29L214 29L214 28L219 28L219 27L228 27ZM223 96L222 96L222 97L216 97L216 98L213 98L213 99L209 99L209 100L206 100L206 101L204 101L204 102L198 103L197 105L195 105L195 106L193 106L192 108L188 109L188 110L187 110L187 111L185 112L185 113L183 113L183 114L182 114L182 115L181 115L181 116L180 116L180 117L179 117L179 118L178 118L178 119L177 119L177 120L175 121L175 122L174 122L174 123L173 123L173 125L172 125L171 127L170 127L170 129L169 129L169 130L168 130L168 132L166 133L165 137L163 138L163 141L162 141L162 143L161 143L161 145L160 145L160 148L159 148L158 154L157 154L157 159L156 159L156 166L155 166L155 177L156 177L156 184L157 184L157 189L158 189L159 195L160 195L160 198L161 198L161 200L162 200L162 202L163 202L163 205L165 206L165 208L166 208L166 210L168 211L168 213L170 214L170 216L171 216L171 217L172 217L173 219L174 219L174 221L175 221L175 222L176 222L176 223L177 223L177 224L178 224L178 225L179 225L179 226L180 226L180 227L182 228L182 229L183 229L183 230L185 230L185 231L186 231L186 232L188 233L188 234L190 234L190 235L191 235L191 236L193 236L193 237L195 237L196 239L198 239L198 240L201 240L201 241L203 241L203 242L205 242L205 243L211 244L211 245L215 245L215 246L219 246L219 247L237 247L247 246L247 245L250 245L250 244L255 244L255 243L257 243L257 242L259 242L259 241L262 241L262 240L266 239L267 237L269 237L269 236L271 236L272 234L274 234L275 232L277 232L277 231L278 231L278 230L279 230L279 229L280 229L280 228L281 228L281 227L282 227L282 226L283 226L283 225L284 225L285 223L286 223L286 222L287 222L287 221L288 221L288 219L289 219L289 218L290 218L291 216L292 216L292 214L294 213L294 211L295 211L296 207L298 206L298 203L299 203L299 201L300 201L300 199L301 199L301 196L302 196L302 192L303 192L303 189L304 189L304 184L305 184L305 158L304 158L304 154L303 154L303 151L302 151L302 147L301 147L301 144L300 144L300 142L299 142L299 140L298 140L298 137L296 136L296 134L295 134L295 132L293 131L293 129L291 128L291 126L290 126L290 125L289 125L288 123L287 123L287 121L286 121L286 120L285 120L285 119L284 119L284 118L283 118L283 117L281 116L281 115L280 115L280 114L278 114L278 112L276 112L276 111L274 110L274 109L270 108L270 107L269 107L269 106L267 106L266 104L264 104L264 103L261 103L261 102L259 102L259 101L256 101L256 100L254 100L254 99L249 99L249 98L246 98L246 97L240 97L240 96Z" Fill="#FFCB0F"><Path.RenderTransform><TranslateTransform X="-31" Y="-26"/></Path.RenderTransform></Path></Canvas></Viewbox><TextBlock Text="Playhub" HorizontalAlignment="Center" Foreground="#F2F2F2" FontSize="16" Margin="0,10,0,0"/></StackPanel>
              </Border>
            </Grid>
            <TextBlock x:Name="MergeBody" Foreground="#D0D0D0" FontSize="13.5" TextWrapping="Wrap" LineHeight="20"/>
          </StackPanel>

          <!-- STATO: PRONTO -->
          <StackPanel x:Name="PanelReady" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="ReadyTitle" Text="Installa Playhub" Foreground="#F2F2F2"
                       FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="ReadySubtitle"
                       Text="Verrà installato per il tuo utente."
                       Foreground="#A8A8A8" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Solo in disinstallazione: cancella anche impostazioni e dati utente. -->
            <CheckBox x:Name="ChkRemoveData" Style="{StaticResource DarkCheck}"
                      Content="Also remove my settings and data" Margin="0,22,0,0"
                      Visibility="Collapsed"/>
            <CheckBox x:Name="ChkRemoveUWPHook" Style="{StaticResource DarkCheck}"
                      Content="Also uninstall UWPHook" Margin="0,12,0,0"
                      Visibility="Collapsed"/>

            <!-- Percorso installazione -->
            <Border x:Name="PathCard" Background="#1B1D1F" CornerRadius="8" Padding="14,10"
                    Margin="0,22,0,0" BorderBrush="#2A2D30" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock x:Name="FolderLabel" Text="CARTELLA" Foreground="#8AFFFFFF" FontSize="10.5"
                             FontWeight="SemiBold"/>
                  <TextBlock x:Name="PathText" Foreground="#E6E6E6" FontSize="13"
                             TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="BtnChangePath" Grid.Column="1" Content="Cambia"
                        Style="{StaticResource GhostButton}"
                        Margin="12,0,0,0"/>
              </Grid>
            </Border>

            <!-- Opzioni -->
            <StackPanel x:Name="OptionsPanel" Margin="0,20,0,0">
              <CheckBox x:Name="ChkDesktop" Style="{StaticResource DarkCheck}"
                        Content="Crea un collegamento sul desktop" IsChecked="True"/>
              <CheckBox x:Name="ChkStartMenu" Style="{StaticResource DarkCheck}"
                        Content="Aggiungi al menu Start" IsChecked="True" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- STATO: AVANZAMENTO -->
          <StackPanel x:Name="PanelProgress" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="ProgressTitle" Text="Installazione in corso…" Foreground="#F2F2F2"
                       FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Preparazione…" Foreground="#A8A8A8"
                       FontSize="13.5" Margin="0,10,0,0"/>
            <ProgressBar x:Name="Prog" Style="{StaticResource FluentProgress}"
                         Minimum="0" Maximum="1" Value="0" Margin="0,22,0,0"/>
          </StackPanel>

          <!-- STATO: FINE -->
          <StackPanel x:Name="PanelDone" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" Background="#FFCB0F"
                    HorizontalAlignment="Left">
              <Path Width="26" Height="26" Stretch="Uniform" Data="M3,11 L9,17 L21,4"
                    Stroke="#1A1A1A" StrokeThickness="3" HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="DoneTitle" Text="Installazione completata" Foreground="#F2F2F2"
                       FontSize="25" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <TextBlock x:Name="DoneSub" Text="Playhub è pronto all'uso." Foreground="#A8A8A8"
                       FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <CheckBox x:Name="ChkLaunchEnd" Style="{StaticResource DarkCheck}"
                      Content="Apri Playhub ora" IsChecked="True" Margin="0,18,0,0"
                      Visibility="Collapsed"/>
          </StackPanel>

          </Grid>

          <!-- Barra azioni FISSA: stessa identica posizione in tutti gli stati -->
          <Grid x:Name="ActionBar" Grid.Row="1" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Content="Annulla" Style="{StaticResource GhostButton}"
                    Visibility="Collapsed"/>
            <Button x:Name="BtnLangNext" Grid.Column="2" Content="Continue" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="BtnMergeNext" Grid.Column="2" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
            <Button x:Name="BtnPrimary" Grid.Column="2" Content="Installa" Style="{StaticResource PrimaryButton}"
                    Visibility="Collapsed"/>
            <Button x:Name="BtnDecline" Content="I decline" Style="{StaticResource GhostButton}"
                    Visibility="Collapsed"/>
            <Button x:Name="BtnAccept" Grid.Column="2" Content="I accept" Style="{StaticResource PrimaryButton}"
                    Visibility="Collapsed"/>
            <Button x:Name="BtnDone" Grid.Column="2" Content="Fine" Style="{StaticResource PrimaryButton}"
                    Visibility="Collapsed"/>
          </Grid>

        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
