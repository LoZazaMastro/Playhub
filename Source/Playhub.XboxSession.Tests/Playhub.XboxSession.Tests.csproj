<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><StartupObject>XboxChecks</StartupObject>
    <DefineConstants>$(DefineConstants);PLAYHUB_TEST_FIXTURE;PLAYHUB_XBOX_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Playhub.XboxSession\**\*.cs" Exclude="..\Playhub.XboxSession\bin\**;..\Playhub.XboxSession\obj\**" Link="XboxSession\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Playhub.GameSession\XboxSessionClient.cs" Link="XboxSessionClient.cs" />
    <Compile Include="..\Shared\SessionFixtureLogs.cs" Link="SessionFixtureLogs.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/EpicLaunchCatalog.cs" Link="EpicLaunchCatalog.cs" />
    <Compile Include="../Shared/EpicLaunchWindows.cs" Link="EpicLaunchWindows.cs" />
    <Compile Include="../Shared/EpicLaunchPayload.cs" Link="EpicLaunchPayload.cs" />
  </ItemGroup>
  <ItemGroup><Content Include="..\Playhub.XboxSession\Native\InputFencePrototype\PlayhubInputFence.dll" Link="PlayhubInputFence.dll" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
