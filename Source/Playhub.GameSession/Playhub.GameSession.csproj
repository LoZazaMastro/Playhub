<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
</PropertyGroup>
  <ItemGroup><Compile Include="../Shared/UwpSessionIdentity.cs" Link="UwpSessionIdentity.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicLaunchCatalog.cs" Link="EpicLaunchCatalog.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicProtocolLaunchRequest.cs" Link="EpicProtocolLaunchRequest.cs" /></ItemGroup>
  <ItemGroup Condition="'$(PlayhubAppContainerBridgeSha256)' != ''">
    <AssemblyMetadata Include="PlayhubCupheadOverlayPilot" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlayhubExplorerFreeUwpActivation)' == 'true' and '$(PlayhubSteamCompanionSha256)' != ''">
    <AssemblyMetadata Include="PlayhubExplorerFreeUwpActivation" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlayhubSteamCompanionSha256)' != ''">
    <AssemblyMetadata Include="PlayhubSteamCompanionSha256" Value="$(PlayhubSteamCompanionSha256)" />
    <AssemblyMetadata Include="PlayhubCupheadSteamCompanion" Value="true" />
    <AssemblyMetadata Include="PlayhubWin32SteamCompanion" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlayhubUwpSteamCompanion)' == 'true' and '$(PlayhubSteamCompanionSha256)' != ''">
    <AssemblyMetadata Include="PlayhubUwpSteamCompanion" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlayhubCupheadWindowedPreference)' == 'true' and '$(PlayhubSteamCompanionSha256)' != ''">
    <AssemblyMetadata Include="PlayhubCupheadWindowedPreference" Value="true" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicLaunchWindows.cs" Link="EpicLaunchWindows.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicLaunchPayload.cs" Link="EpicLaunchPayload.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/StoreLibraryModels.cs" Link="StoreLibraryModels.cs" />
    <Compile Include="../Shared/StoreLibraryLaunchRequest.cs" Link="StoreLibraryLaunchRequest.cs" />
    <Compile Include="../Shared/StorePrivateLaunchModels.cs" Link="StorePrivateLaunchModels.cs" />
    <Compile Include="../Shared/StorePrivateLaunchClient.cs" Link="StorePrivateLaunchClient.cs" />
    <Compile Include="../Shared/StoreLibraryUiClient.cs" Link="StoreLibraryUiClient.cs" />
    <Compile Include="../Playhub.StoreHost/StoreLibraryService.cs" Link="StoreLibraryService.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/StoreGdkLaunchDefinition.cs" Link="StoreGdkLaunchDefinition.cs" /></ItemGroup>
</Project>
