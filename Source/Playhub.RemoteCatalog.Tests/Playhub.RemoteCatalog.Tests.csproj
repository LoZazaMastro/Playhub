<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlayhubUiReview)' == 'true'">
    <DefineConstants>$(DefineConstants);PLAYHUB_UI_REVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Playhub/Services/RemotePluginCatalogService.cs" Link="RemotePluginCatalogService.cs" />
    <Compile Include="../Playhub/Models/RemotePluginCatalog.cs" Link="RemotePluginCatalog.cs" />
    <Compile Include="../Playhub/Services/PluginCatalogService.cs" Link="PluginCatalogService.cs" />
    <Compile Include="../Playhub/Models/DeckyPluginInfo.cs" Link="DeckyPluginInfo.cs" />
    <Compile Include="../Playhub/MainWindow.RemoteCatalog.cs" Link="MainWindow.RemoteCatalog.cs" />
    <Content Include="../../catalog/plugins.json" Link="Assets/PluginCatalog/store-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Playhub/Assets/PluginCatalog/external-plugins.json" Link="Assets/PluginCatalog/external-plugins.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Use the SDK parser for lossless provenance checks, without a NuGet dependency. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
