 const { PanelSection, PanelSectionRow, DropdownItem, ButtonItem, Router } = DFL as any;
+function ControllerRuntimeDiagnostics({ locale }: { locale: string }) {
+  const [result, setResult] = React.useState<DiagnosticResult | null>(null);
+  const [pending, setPending] = React.useState(false);
+  const busy = React.useRef(false);
+  const alive = React.useRef(true);
+  React.useEffect(() => { alive.current = true; return () => { alive.current = false; }; }, []);
+  const copy = controllerDiagnosticCopy(locale);
+  return <PanelSection title={copy.title}>
+    <PanelSectionRow><ButtonItem label={copy.check} bottomSeparator="none" disabled={pending}
+      onClick={async () => {
+        if (busy.current || !alive.current) return;
+        busy.current = true; setPending(true); setResult(null);
+        const next = await requestControllerDiagnostic(method => directDeckyCall(method));
+        busy.current = false;
+        if (alive.current) { setResult(next); setPending(false); }
+      }}><TbRotateClockwise title={copy.check} /></ButtonItem></PanelSectionRow>
+    <PanelSectionRow><div role="status" style={{ overflowWrap: "anywhere" }}>
+      {pending ? copy.pending : controllerDiagnosticText(result, locale)}
+    </div></PanelSectionRow>
+  </PanelSection>;
+}
+
 const actions: ControllerAction[] = ["settings", "test", "sticks", "gyro", "layout"];
